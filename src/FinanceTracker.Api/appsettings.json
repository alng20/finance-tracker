{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=6000;Database=FinanceTracker;Username=postgres;Password=postgres"
  },
  "DatabaseSeeder": {
    "IsEnabled": false
  },
  "Jwt": {
    "Issuer": "FinanceTracker",
    "Audience": "FinanceTracker.Api",
    "SecretKey": "IamSuperSecretKeyButMoveMeToKeyVaultLater",
    "ExpirationMinutes": 60
  },
  "RefreshToken": {
    "ExpirationDays": 30,
    "TokenLength": 64
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/finance-tracker-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  }
}