{
  "Jwt": {
    "Issuer": "FinanceTracker",
    "Audience": "FinanceTracker.Api",
    "ExpirationMinutes": 60
  },
  "RefreshToken": {
    "ExpirationDays": 30,
    "TokenLength": 64
  },
  "RefreshTokenCookies": {
    "Name": "refreshToken",
    "HttpOnly": true,
    "Secure": false,
    "SameSite": "Strict",
    "Path": "/api/auth"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/finance-tracker-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5174"
    ]
  }
}